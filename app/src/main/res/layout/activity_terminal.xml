<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_hero"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="180"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:fontFamily="monospace"
                    android:letterSpacing="-0.01"
                    android:shadowColor="#33000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="Terminal"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnClear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_toStartOf="@+id/btnRootToggle"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear"
                    android:src="@drawable/ic_close"
                    app:tint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoot"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="@color/semantic_success"
                    android:text="SH"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="16dp" />
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Working directory display -->
    <TextView
        android:id="@+id/tvWorkDir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_surface"
        android:fontFamily="monospace"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="~"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="11sp" />

    <!-- Quick command chips -->
    <HorizontalScrollView
        android:id="@+id/quickCommands"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_surface"
        android:paddingVertical="6dp"
        android:paddingHorizontal="8dp"
        android:scrollbars="none" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2sp"
            android:textColor="@color/dark_on_surface"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Quick Actions Bar -->
    <LinearLayout
        android:id="@+id/quickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_surface"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/btnRunScript"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_badge_code"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="4dp"
            android:drawableTint="@color/semantic_success"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Run Script"
            android:textColor="@color/semantic_success"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSaveLog"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_document"
            android:drawableStart="@drawable/ic_content_copy"
            android:drawablePadding="4dp"
            android:drawableTint="@color/brand_indigo"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Save Log"
            android:textColor="@color/brand_indigo"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnShareLog"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_badge_image"
            android:drawableStart="@drawable/ic_share"
            android:drawablePadding="4dp"
            android:drawableTint="@color/semantic_warning"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="Share"
            android:textColor="@color/semantic_warning"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dark_surface_high" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/promptLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingEnd="8dp"
            android:text="$"
            android:textColor="@color/brand_teal"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/commandInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:hint="type a command…"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textNoSuggestions|textVisiblePassword"
            android:singleLine="true"
            android:textColor="@color/dark_on_surface"
            android:textColorHint="@color/dark_on_surface_dim"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
