<?xml version="1.0" encoding="utf-8"?>
<!-- Clawless Explorer — Clean v3: flat M3 surface, no gradient hero, no canvas animations.
     Reading: Android file manager for power users, calm Files-by-Google language, M3 baseline.
     Dials: VARIANCE 4 / MOTION 3 / DENSITY 6. Content-first, single accent, one breadcrumb system. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <!-- ========== CLEAN APP BAR: flat surface, static title ========== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:fitsSystemWindows="true"
            app:elevation="0dp"
            app:liftOnScroll="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <!-- Toolbar row -->
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    android:contentInsetStartWithNavigation="0dp"
                    android:contentInsetEndWithActions="0dp"
                    app:contentInsetStart="0dp"
                    app:contentInsetEnd="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageButton
                            android:id="@+id/btnMenu"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Open menu"
                            android:src="@drawable/ic_menu"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/tvTypewriter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.01"
                            android:maxLines="1"
                            android:text="Clawless Explorer"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="19sp" />

                        <ImageButton
                            android:id="@+id/btnHiddenToggle"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/btnViewToggle"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Toggle hidden files"
                            android:src="@drawable/ic_visibility_off"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:alpha="0.9" />

                        <ImageButton
                            android:id="@+id/btnViewToggle"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/btnSettings"
                            android:contentDescription="Toggle grid/list view"
                            android:src="@drawable/ic_grid_view"
                            app:tint="?attr/colorOnSurfaceVariant"
                            android:background="?attr/selectableItemBackgroundBorderless" />

                        <ImageButton
                            android:id="@+id/btnSettings"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/btnSearch"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Settings"
                            android:src="@drawable/ic_settings"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <ImageButton
                            android:id="@+id/btnSearch"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Search"
                            android:src="@drawable/ic_search"
                            app:tint="?attr/colorOnSurface" />
                    </RelativeLayout>
                </androidx.appcompat.widget.Toolbar>

                <!-- ===== COMPACT STORAGE CARD: single surface, no glass, no animation ===== -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/storageCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="4dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.06"
                                android:text="STORAGE"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/storageText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif"
                                android:text="Loading..."
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />

                            <ImageView
                                android:id="@+id/storageChevron"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_chevron_right"
                                android:rotation="-90"
                                android:visibility="gone"
                                app:tint="?attr/colorOnSurfaceVariant" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.01"
                            android:text="Internal Storage"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="17sp" />

                        <!-- Stacked horizontal bar (file-type breakdown) -->
                        <LinearLayout
                            android:id="@+id/storageBar"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_storage_track"
                            android:clipChildren="true"
                            android:orientation="horizontal"
                            android:weightSum="100">

                            <View
                                android:id="@+id/segImage"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@color/brand_pink" />

                            <View
                                android:id="@+id/segVideo"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@color/brand_teal" />

                            <View
                                android:id="@+id/segAudio"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@color/semantic_warning" />

                            <View
                                android:id="@+id/segDocs"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@color/semantic_info" />

                            <View
                                android:id="@+id/segArchive"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="0"
                                android:background="@color/file_archive" />

                            <View
                                android:id="@+id/segOther"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="100"
                                android:background="@android:color/transparent" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_badge_circle"
                                    android:backgroundTint="@color/brand_pink" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/imageSizeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="0 B"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:letterSpacing="0.04"
                                        android:text="IMAGES"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_badge_circle"
                                    android:backgroundTint="@color/brand_teal" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/videoSizeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="0 B"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:letterSpacing="0.04"
                                        android:text="VIDEOS"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="8dp"
                                    android:layout_height="8dp"
                                    android:background="@drawable/bg_badge_circle"
                                    android:backgroundTint="@color/semantic_warning" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/audioSizeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="0 B"
                                        android:textColor="?attr/colorOnSurface"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="sans-serif"
                                        android:letterSpacing="0.04"
                                        android:text="AUDIO"
                                        android:textColor="?attr/colorOnSurfaceVariant"
                                        android:textSize="10sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- ===== SEARCH BAR (hidden by default) ===== -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchLayout"
                style="@style/Widget.Clawless.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:hint="Search files..."
                android:visibility="gone"
                app:endIconDrawable="@drawable/ic_mic"
                app:endIconMode="custom"
                app:startIconDrawable="@drawable/ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingVertical="14dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ===== FILTER CHIPS: single row, calm ===== -->
            <HorizontalScrollView
                android:id="@+id/filterScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="4dp"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/filterChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:checked="true"
                        android:text="All"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_nav_root"
                        app:chipIconSize="16dp"
                        app:chipIconTint="?attr/colorOnSurface"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterImage"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="Images"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_file_image"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/file_image"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterVideo"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="Videos"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_file_video"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/file_video"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAudio"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="Audio"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_file_audio"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/file_audio"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterDocs"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="Docs"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_file_document"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/file_document"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterArchive"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="Archives"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_file_archive"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/file_archive"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterApk"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="true"
                        android:text="APKs"
                        android:textSize="13sp"
                        app:chipIcon="@drawable/ic_file_apk"
                        app:chipIconSize="16dp"
                        app:chipIconTint="@color/file_apk"
                        app:chipBackgroundColor="@color/chip_filter_bg"
                        app:chipStrokeColor="@color/chip_filter_stroke"
                        app:chipStrokeWidth="1dp" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

        </com.google.android.material.appbar.AppBarLayout>

        <!-- ========== SINGLE BREADCRUMB SYSTEM ========== -->
        <com.example.clawlessexplorer.BreadcrumbView
            android:id="@+id/breadcrumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            android:elevation="0dp" />

        <!-- ========== FILE LIST ========== -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="120dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- ========== EMPTY STATE: single circle, no halo ========== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:contentDescription="Empty"
                    android:src="@drawable/ic_empty_state"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.01"
                    android:text="Nothing here yet"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="This folder is empty.\nCreate a new file or folder."
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/emptyStateCreateBtn"
                    style="@style/Widget.Clawless.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Create New"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== SELECTION ACTION BAR (bottom) ========== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    app:cardBackgroundColor="?attr/colorPrimary"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/selectionBarCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:minWidth="28dp"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="0"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="13sp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="selected"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/selectionSelectAll"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Select All"
                    android:padding="10dp"
                    android:src="@drawable/ic_check"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/selectionShare"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Share"
                    android:padding="10dp"
                    android:src="@drawable/ic_share"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/selectionCopy"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Copy"
                    android:padding="10dp"
                    android:src="@drawable/ic_content_copy"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/selectionMove"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Move"
                    android:padding="10dp"
                    android:src="@drawable/ic_swap_move"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/selectionMore"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="More"
                    android:padding="10dp"
                    android:src="@drawable/ic_more_horiz"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/selectionDelete"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:padding="10dp"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/colorError" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ========== FAB ========== -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAdd"
            style="@style/Widget.Clawless.Fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="New"
            app:icon="@drawable/ic_add" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="?attr/colorOnSurfaceVariant"
        app:itemTextColor="?attr/colorOnSurface"
        app:itemRippleColor="?attr/colorPrimaryContainer"
        app:itemShapeFillColor="?attr/colorSurfaceVariant"
        app:itemShapeAppearance="@style/ShapeAppearance.Clawless.Medium"
        app:itemShapeInsetStart="12dp"
        app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetTop="4dp"
        app:itemShapeInsetBottom="4dp"
        app:itemHorizontalPadding="16dp"
        app:menu="@menu/menu_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
